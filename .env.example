# Mullion host switches. Copy to .env (git-ignored); tools/run-host.sh loads it.
# Booleans: 1/0, true/false, yes/no, on/off. A CLI flag still overrides these.
# See the live values at http://<mac-ip>:47100/config

MULLION_EXTEND=true              # virtual displays (Extend mode). false = Mirror only
MULLION_DISPLAY_GRACE_SECS=30    # how long a left device's screen lingers; 0 = remove at once
MULLION_ARRANGE=true             # auto-arrange displays after create/remove
MULLION_PROBE=true               # burn the latency strip into frames
MULLION_REQUIRE_HW_ENCODER=true  # FR-8; false allows the software encoder (diagnosis only)
MULLION_MULTI_SESSION=true       # several receivers at once; false = newest replaces
MULLION_DEBUG=false              # verbose host + str0m logs

MULLION_PORT=47100
MULLION_FPS=60
MULLION_BITRATE_KBPS=10000
MULLION_WIDTH=1920
MULLION_HEIGHT=1080
